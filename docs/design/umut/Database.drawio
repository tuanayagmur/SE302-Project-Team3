        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction LR\n\n    class exam_period {\n        int period_id PK\n        date start_date\n        date end_date\n        int default_exam_duration\n        int changeover_minutes\n        int students_per_invigilator\n        int invigilator_break_minutes\n    }\n\n    class excluded_day {\n        int period_id PK, FK\n        date excluded_date PK\n    }\n\n    class time_slot {\n        int slot_id PK\n        int period_id FK\n        date exam_date\n        int slot_number\n        time start_time\n        time end_time\n    }\n\n    class course {\n        varchar course_code PK\n        int exam_duration\n        int difficulty_level\n        int fixed_slot_id FK\n    }\n\n    class student {\n        varchar student_id PK\n    }\n\n    class enrollment {\n        varchar course_code PK, FK\n        varchar student_id PK, FK\n    }\n\n    class classroom {\n        int classroom_id PK\n        varchar name UK\n        int capacity\n    }\n\n    class classroom_feature {\n        int classroom_id PK, FK\n        varchar feature_name PK\n    }\n\n    class course_required_feature {\n        varchar course_code PK, FK\n        varchar feature_name PK\n    }\n\n    class classroom_unavailability {\n        int classroom_id PK, FK\n        int slot_id PK, FK\n    }\n\n    class invigilator {\n        int invigilator_id PK\n        varchar name UK\n    }\n\n    class invigilator_unavailability {\n        int invigilator_id PK, FK\n        int slot_id PK, FK\n    }\n\n    class exam_schedule {\n        int schedule_id PK\n        int period_id FK\n        varchar status\n    }\n\n    class scheduled_exam {\n        int scheduled_exam_id PK\n        int schedule_id FK\n        varchar course_code FK\n        int slot_id FK\n    }\n\n    class classroom_allocation {\n        int allocation_id PK\n        int scheduled_exam_id FK\n        int classroom_id FK\n    }\n\n    class allocation_student {\n        int allocation_id PK, FK\n        varchar student_id PK, FK\n    }\n\n    class allocation_invigilator {\n        int allocation_id PK, FK\n        int invigilator_id PK, FK\n    }\n\n    exam_period \&quot;1\&quot; -- \&quot;0..*\&quot; excluded_day\n    exam_period \&quot;1\&quot; -- \&quot;1..*\&quot; time_slot\n    time_slot \&quot;0..1\&quot; -- \&quot;0..*\&quot; course : fixed_slot\n\n    course \&quot;1\&quot; -- \&quot;0..*\&quot; enrollment\n    student \&quot;1\&quot; -- \&quot;0..*\&quot; enrollment\n\n    classroom \&quot;1\&quot; -- \&quot;0..*\&quot; classroom_feature\n    course \&quot;1\&quot; -- \&quot;0..*\&quot; course_required_feature\n\n    classroom \&quot;1\&quot; -- \&quot;0..*\&quot; classroom_unavailability\n    time_slot \&quot;1\&quot; -- \&quot;0..*\&quot; classroom_unavailability\n\n    invigilator \&quot;1\&quot; -- \&quot;0..*\&quot; invigilator_unavailability\n    time_slot \&quot;1\&quot; -- \&quot;0..*\&quot; invigilator_unavailability\n\n    exam_period \&quot;1\&quot; -- \&quot;0..*\&quot; exam_schedule\n    exam_schedule \&quot;1\&quot; -- \&quot;1..*\&quot; scheduled_exam\n    course \&quot;1\&quot; -- \&quot;0..*\&quot; scheduled_exam\n    time_slot \&quot;1\&quot; -- \&quot;0..*\&quot; scheduled_exam\n\n    scheduled_exam \&quot;1\&quot; -- \&quot;1..*\&quot; classroom_allocation\n    classroom \&quot;1\&quot; -- \&quot;0..*\&quot; classroom_allocation\n\n    classroom_allocation \&quot;1\&quot; -- \&quot;1..*\&quot; allocation_student\n    student \&quot;1\&quot; -- \&quot;0..*\&quot; allocation_student\n\n    classroom_allocation \&quot;1\&quot; -- \&quot;0..*\&quot; allocation_invigilator\n    invigilator \&quot;1\&quot; -- \&quot;0..*\&quot; allocation_invigilator&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="xVQoWerg2QGAiklhPwYs-914">
