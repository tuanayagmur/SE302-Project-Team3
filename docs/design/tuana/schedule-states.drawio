<mxfile><diagram name="ExamSchedule states"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="VAL2&lt;hr&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;the schedule matches the current data&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="170" width="220" height="90" as="geometry"/></mxCell><mxCell id="3" value="OUTDATED&lt;hr&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;data changed after the schedule was created&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="170" width="220" height="90" as="geometry"/></mxCell><mxCell id="4" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="50" y="205" width="20" height="20" as="geometry"/></mxCell><mxCell id="5" value="generate()&amp;#xa;[validate(s) has no errors]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="4" target="2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6" value="data or exam period changed / markOutdated()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7" value="update(s) or generate()&amp;#xa;[validate(s) has no errors]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="3" target="2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="8" value="exam moved by hand&amp;#xa;[checkMove(e, t) has no errors]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.3;exitY=1;entryX=0.65;entryY=1;" edge="1" parent="